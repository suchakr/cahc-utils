core.wait(16); 


function angleBetween(ra1, dec1, ra2, dec2) {
  ra1 *= Math.PI / 180;
  dec1 *= Math.PI / 180;
  ra2 *= Math.PI / 180;
  dec2 *= Math.PI / 180;
  var ans = Math.acos(Math.sin(dec1) * Math.sin(dec2) + Math.cos(dec1) * Math.cos(dec2) * Math.cos(ra1 - ra2))
  ans = ans < 0 ? -ans : ans;
  return ans * 180 / Math.PI;
}

function naks_info(arr) {
  //core.debug(arr.length);
  //return

  var name = arr[0].split(/\s+/)[1];
  var descr = arr[0];
  var descr1 = arr[1];
  var hips = arr[3].split(/\s+/);
  hips.shift();
  hips.shift();
  var hip = hips[0];
  var sanskrit_name = arr[4];
  var shape = arr.length > 5 ? arr[5] : "";



  var ans = {
    sanskrit_name: sanskrit_name,
    shape: shape,
    name: name,
    descr: descr,
    descr1: descr1,
    hip: "HIP" + hip,
    hips: hips.map(function (h, i) {
      return "HIP" + h
    })
  }
  return ans;
}

// Function to convert Ecliptic (lon, lat) to RA/Dec J2000
function eclipticToEquatorial(lon, lat) {
    var e = 23.439 * (Math.PI / 180); // Obliquity of ecliptic in radians
    var l = lon * (Math.PI / 180);    // Longitude to radians
    var b = lat * (Math.PI / 180);    // Latitude to radians

    var raRad = Math.atan2(Math.sin(l) * Math.cos(e) - Math.tan(b) * Math.sin(e), Math.cos(l));
    var decRad = Math.asin(Math.sin(b) * Math.cos(e) + Math.cos(b) * Math.sin(e) * Math.sin(l));

    return {
        ra: (raRad * 180 / Math.PI + 360) % 360,
        dec: decRad * 180 / Math.PI
    };
}


