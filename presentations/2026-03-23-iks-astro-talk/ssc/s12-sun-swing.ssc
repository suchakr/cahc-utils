6, 2451852.546904313, 2451853.547313857, 2451854.547728699, 2451855.548148375, 2451856.5485727666, 2451857.549001752, 2451858.5494352076, 2451859.549873009, 2451860.550315026, 2451861.5507618603, 2451862.5512133045, 2451863.5516685606, 2451864.5521274423, 2451865.552589735, 2451866.5530551975, 2451867.553523562, 2451868.553994533, 2451869.5544693754, 2451870.554946231, 2451871.555424689, 2451872.5559043624, 2451873.556384848, 2451874.5568657303, 2451875.5573465824, 2451876.5578282173, 2451877.558309492, 2451878.558789426, 2451879.55926757, 2451880.559743473, 2451881.5602166858, 2451882.560686759, 2451883.5611539427, 2451884.5616182163, 2451885.5620780084, 2451886.5625328883, 2451887.562982437, 2451888.563426253, 2451889.563863944, 2451890.564295128, 2451891.564720487, 2451892.5651392206, 2451893.5655502677, 2451894.565953232, 2451895.5663477047, 2451896.5667332704, 2451897.5671095056, 2451898.567475984, 2451899.567832276, 2451900.56817892, 2451901.5685149343, 2451902.568839434, 2451903.569152009, 2451904.569452259, 2451905.569739797, 2451906.57001425, 2451907.5702752615, 2451908.5705224937, 2451909.570755628, 2451910.570974363];


var $JD_0 = 1721057.284468;
function W(x)  { if (!x) x = 0.1; core.wait(x); }
function JD(x) { if (x) { core.setJDay(x); W(0.04); } return core.getJDay(); }
var getOI = core.getObjectInfo;

function resetScene() {
  LabelMgr.deleteAllLabels();
  MarkerMgr.deleteAllMarkers();
}

function label(text, x, y, size, color) {
  var id = LabelMgr.labelScreen(text, x, y, false, size, color);
  LabelMgr.setLabelShow(id, true);
  return id;
}

var epochRuns = [
  { year_name: "1800 BCE", year_num: 1800, arr: SUNRISES_BCE_1800 },
  // { year_name: "1350 BCE", year_num: 1350, arr: SUNRISES_BCE_1350 },
  { year_name: "2000 CE",  year_num: -2000, arr: SUNRISES_CE_2000 }
];

for (var e = 0; e < epochRuns.length; e++) {
  var run = epochRuns[e];
  var SUNRISES = run.arr;
  var year = run.year_num;
  var year_label = run.year_name;
  
  for (var repeat_show = 0; repeat_show < 1; repeat_show++) {
    
    resetScene();
    core.setGuiVisible(false);
    core.setObserverLocation("Ujjain, India", "Earth");
    
    LandscapeMgr.setFlagLandscape(repeat_show == 0 ? true : false);
    LandscapeMgr.setFlagAtmosphere(repeat_show == 0 ? true : false);
    try {LandscapeMgr.setFlagGround(repeat_show == 0 ? false : true);} catch(err) {}
    LandscapeMgr.setFlagFog(false);
    LandscapeMgr.setFlagCardinalPoints(true);
    GridLinesMgr.setFlagAzimuthalGrid(true);
    GridLinesMgr.setFlagEquatorGrid(false);
    GridLinesMgr.setFlagEclipticLine(false);
    GridLinesMgr.setFlagEquatorLine(false);
    
    // Show constellation asterism lines
    ConstellationMgr.setFlagLines(true);
    // Optional: also show constellation names
    ConstellationMgr.setFlagLabels(true);
    // Optional: show constellation boundaries
    ConstellationMgr.setFlagBoundaries(true);
    
    core.moveToAltAzi(5, 90, 0);       // face east, 5° altitude
    StelMovementMgr.zoomTo(60, 0);     // zoom in to 60° FOV
    try { core.setSkyCulture("vedic_25_codex"); } catch (err) { core.setSkyCulture("indian"); } 
    
    // Scale Sun to 15x and try to turn off glare
    try { SolarSystem.setFlagSunScale(true); SolarSystem.setSunScale(15); } catch(err) {}
    try { StelSkyDrawer.setFlagSunGlare(false); } catch(err) {}
    try { SolarSystem.setFlagGlare(false); } catch(err) {}
    
    // Intro title sequence
    label("The Sun's Annual Swing (" + year_label + ")", 70, 140, 36, "#FFAAAA");
    label("Ujjain (East View): watch sunrise move northward and southward.", 70, 210, 30, "#FFFFFF");
    label("The turning points are the solstices; the middle crossings are the equinoxes.", 70, 250, 30, "#FFFFFF");
    if ( e == 0 ) {
      label("Demo setup: Change astersim/ eclipitic setting if you like - Demo starts in 15 seconds", 70, 790, 25, "#FFFFFF");
    }
    
    // Prime the sky to the first calculated sunrise
    JD(SUNRISES[0]);
    if ( e == 0 ) {
      W(15); // Wait 30s as per user request W(15*2)
    }
    
    resetScene();
    label("Sunrise Shift Through the Year " + year_label, 70, 50, 30, "#FFD166");
    label("Ujjain: facing East at exact sunrise", 70, 95, 18, "#DDDDDD");
    W(1);
    
    var flagged = {};
    // Sweep through all exactly calculated Astropy sunrises for the 366-day year
    for (var d = 0; d < SUNRISES.length; d++) {
      // Use exact pre-calculated JD from astropy
      JD(SUNRISES[d] + (.15/24) * (repeat_show == 0 ? 1 : -1));
      W(0.1);
      
      // Look for the sun's exact longitude to mark solstices and equinoxes
      var sunInfo = getOI("Sun");
      var kind = null;
      if (!flagged.summer && Math.abs(sunInfo.elong - 90) < 1.0) { kind = "Summer Solstice"; flagged.summer = true; }
      else if (!flagged.autumn && Math.abs(sunInfo.elong - 180) < 1.0) { kind = "Autumn Equinox"; flagged.autumn = true; flagged.dip = true; }
      else if (!flagged.winter && Math.abs(sunInfo.elong - 270) < 1.0) { kind = "Winter Solstice"; flagged.winter = true; }
      else if (!flagged.spring && (sunInfo.elong < 1.0 || sunInfo.elong > 359.0)) { kind = "Spring Equinox"; flagged.spring = true; }
      
      if (kind) {
        // Calculate horizontal screen position relative to center (Azi 90).
        var centerAzimuth = 90;
        var w = core.getScreenWidth();
        var h = core.getScreenHeight();
        
        // Convert azimuth to X pixel coordinate on screen
        var degreesFromCenter = sunInfo.azimuth - centerAzimuth;
        var pixelsPerDegree = w / 90; 
        var x = (w / 2) + (degreesFromCenter * pixelsPerDegree) - 60; 
        
        // Drop the label (with a dip flag check for autumn layout logic)
        label(kind, x, h / 2 + 100 + (flagged.dip && kind == "Autumn Equinox" ? 30 : 0), 20, "#FFD166");
      }
    }
    
    label("The sunrise point swings northward to the June solstice and southward to the December solstice.", 70, 1030, 20, "#FFFFFF");
    W(2)
    label("This is the exact horizon expression of the Sun's annual motion in " + year_label + ".", 70, 1070, 20, "#AABBFF");
    W(2);
    label("Demo complete.", 700, 860, 24, "#AABBFF");
  }
}
W(5);
