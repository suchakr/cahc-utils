// a11-moon-purnima-rise-sun5.ssc
// Variant of a10-moon-shranga-sun9.ssc: capture each PURNIMA (full moon)
// event at the moment the SUN is at -5 deg altitude (early dusk), seeded
// off MOONRISE (not moonset) -- a full moon rises near sunset and is
// visible in the east, unlike the moonset-based crescent series where the
// moon sets shortly after sunset.
//
// MUST be run via `stelrc.py run-script a11-moon-purnima-rise-sun5.ssc` (the
// native named-script loader, /scripts/run), NOT `run-file`/`script-direct`
// -- see chandra-marga/README.md "One-time setup" for why include() needs
// this.
//
// JDS (via include(), below) are precomputed via chandra-marga:
//   1. scripts/00_compute_base_events.py --event-type rise ... ->
//      stel_scripts/lunar-rise-events--0527.inc (purnima moonrise JDs)
//   2. scripts/01_compute_events.py --source-inc lunar-rise-events--0527.inc
//      --paksha shukla --thithi 15 --target-body sun --target-altitude -5.0
//      --event-type set -> stel_scripts/sun-alt-minus5-events--0527.inc
// Astropy-only (no live Stellarium Newton-refinement pass has been done for
// this series yet, unlike a10's sun-alt-9 series) -- Sun altitude may be off
// by up to ~0.1-0.4 deg for -527 BCE dates the same way the sun-9 series
// was before it was refined. Spot-check against live Stellarium before a
// production run if precision matters.
//
// Framing: camera centers on (az=moon.azimuth, alt=0) every event -- same
// fixed-pixel-rectangle tile-crop convention as a10. FOV is left exactly as
// primed live in Stellarium (no zoomTo() override here).
//
// Ground: OFF (LandscapeMgr.setFlagLandscape(false)) -- kept off for
// consistency with the tile-crop/camera pipeline, even though nasta-candra
// (invisible below-horizon moon) is not a concern for a full moon. Moon
// altitude at capture is expected to be mildly positive (varies by month,
// per chandra-marga's az/alt-variation validation), occasionally grazing
// the horizon.
//
// Observer: Kurukshetra lat=29.9697 lon=76.8786 elev=0 (same as a9/a10).
// Moon scale: 20x (set explicitly).
// Output: moon-shranga~/rise-sun5/-527/purnima/  (parallel tree; a9/a10 outputs untouched)

MODE = "rise-sun-below-west-5"
YEAR = -527
TITHI = "purnima"
// PILOT = [0, 10, 25, 40, 50]  // pilot spot-check subset; set to null for the full 51-event run
PILOT = null
SUN_TARGET_ALT = -5.0      // deg (for title display only; JDS already solved)

// Binding: this filename must match whatever `01_compute_events.py` wrote
// for this (target-body, target-altitude, year) combination -- regenerate
// with e.g.:
//   uv run python scripts/01_compute_events.py --source-inc lunar-rise-events--0527.inc \\
//     --paksha shukla --thithi 15 --target-body sun --target-altitude -5.0 \\
//     --event-type set --year-tag 0527
include("sun-alt-minus5-events--0527.inc");
JDS = SUN_ALT_MINUS5_JDS[TITHI];

// ---- minimal helpers (subset of nakshatras.inc, inlined) ----
function say(x) { core.debug('' + x) }
function W(x) { if (!x) x = 0.1; core.wait(x) }
function JD(x) { if (x) { core.setJDay(x); W() } return core.getJDay() }
function DT() { return core.getDate("utc") }
getOI = core.getObjectInfo
function RND(n, d) { return Math.round(n * Math.pow(10, d)) / Math.pow(10, d) }
function R2(n) { return RND(n, 2) }
var $TITLE_X = 200; var $TITLE_Y = 60;
var $TITLE_IDS = [];
// cls() deletes ONLY the title labels we created (tracked by id), so the
// horizon compass labels drawn at setup survive the whole run.
// (LabelMgr.deleteAllLabels() would wipe them too -- known gotcha.)
function cls() {
  for (var k = 0; k < $TITLE_IDS.length; k += 1) { LabelMgr.deleteLabel($TITLE_IDS[k]) }
  $TITLE_IDS = [];
  $TITLE_Y = 60
}
function titles(t) {
  var id = LabelMgr.labelScreen('' + t, $TITLE_X, $TITLE_Y, false, 25, "#ABCDDD");
  LabelMgr.setLabelShow(id, true);
  $TITLE_IDS.push(id);
  $TITLE_Y += 27
  core.wait(.5)
}

// Horizon compass azimuth labels: native SpecialMarkersMgr compass marks only
// print numeric labels every 15 deg (hard-coded); overlay our own every
// AZ_STEP deg via LabelMgr.labelHorizon (azimuth: 0=N 90=E 180=S 270=W).
// Session-only labels; redrawn each run. Skips the natively-labeled azimuths.
AZ_STEP = 5; AZ_NATIVE_STEP = 15;
AZ_LABEL_ALT = 1.0;          // deg above horizon line
AZ_FONT = 10; AZ_COLOR = "#ff40ff";  // match native magenta compass labels
function drawCompassLabels() {
  for (var az = 0; az < 360; az += AZ_STEP) {
    if (az % AZ_NATIVE_STEP === 0) continue;
    LabelMgr.labelHorizon(az + "\u00B0", az, AZ_LABEL_ALT, true, AZ_FONT, AZ_COLOR);
  }
}
function screenshot(dir, fn) {
  var filename = fn || '000-zap0';
  say(filename)
  core.screenshot(
    filename,
    false, // invert
    "/Users/sunder/projects/cahc/cahc-utils/stel_scripts/moon-shranga~/" + MODE + "/" + YEAR + (dir ? "/" + dir : ''),
    true,  // overwrite
    "jpg"
  )
}

// ---- setup ----
LabelMgr.deleteAllLabels()   // fresh slate once, before drawing our overlays
core.setTimeRate(0)          // freeze clock
core.setObserverLocation(  // kuru lat=29.9697 lon=76.8786
  76.8786, // longitude
  29.9697, // latitude
  0        // elevation
)
// Moon scale
SolarSystem.setFlagMoonScale(true);
SolarSystem.setMoonScale(20);
// Labels: off -- multiple paths for robustness (Indian sky-culture uses localized names)
SolarSystem.setFlagLabels(false);
StarMgr.setFlagLabels(false);
SolarSystem.setFlagHints(false);
// Property path (Stellarium SSC core.setPropertyValue available in 0.21+)
try { core.setPropertyValue("SolarSystem.labelsDisplayed", false); } catch(e) { say("no core.setPropertyValue") }
// Atmospheric refraction squashes discs near the horizon into an oblong/egg
// shape (differential refraction across the disc) -- barely visible on a
// thin crescent but very obvious on a near-full disc. Disabling it (pressure
// = 0) is a live Stellarium setting that does NOT persist across app
// restarts, so it must be set here rather than relied on as ambient state.
// NOTE: core.setPropertyValue is NOT a function in this Stellarium build
// (confirmed: it throws an uncaught TypeError and aborts the whole script,
// unlike the SolarSystem.labelsDisplayed call below which is defensively
// try/catch-wrapped) -- StelSkyDrawer.setAtmospherePressure() is the real,
// working scriptable setter, verified directly against the running instance.
StelSkyDrawer.setAtmospherePressure(0);
// Ground: OFF -- kept consistent with a10's camera/tile-crop convention.
LandscapeMgr.setCurrentLandscapeName("Zero Horizon");
LandscapeMgr.setFlagLandscape(false);
LandscapeMgr.setFlagAtmosphere(true);   // twilight sky comes from atmosphere, not landscape
GridLinesMgr.setFlagHorizonLine(true);
SpecialMarkersMgr.setFlagCompassMarks(true);
// Azimuthal grid: off (keeps frame clean)
GridLinesMgr.setFlagAzimuthalGrid(false);
StelMovementMgr.setFlagTracking(false);
// No zoomTo() -- FOV is left exactly as primed live in Stellarium.
drawCompassLabels()

titles("Moon Purnima Rise - " + TITHI + " - sun@" + SUN_TARGET_ALT + " - " + YEAR)
W(2)
core.wait(3)   // settle after setup burst, before first event

cls()

// ---- main loop ----
// No live solving: JDS[] are already precomputed sun-alt-5 crossings.
for (i = 0; i < JDS.length; i += 1) {
  if (PILOT && PILOT.indexOf(i) < 0) { continue }

  JD(JDS[i]); core.wait(1)
  sun = getOI("Sun")

  // Self-verifying settle: getObjectInfo() can return a STALE value for a
  // few seconds after setJDay() (confirmed empirically in the a10 series --
  // a genuine, non-deterministic render/update-thread race). Since every
  // JDS[] value is precomputed to sun altitude = SUN_TARGET_ALT, re-querying
  // until the readback actually matches is self-correcting regardless of cause.
  for (retry = 0; retry < 8 && Math.abs(sun['altitude'] - SUN_TARGET_ALT) > 0.3; retry += 1) {
    core.wait(1.5)
    sun = getOI("Sun")
  }
  if (Math.abs(sun['altitude'] - SUN_TARGET_ALT) > 0.3) {
    say("WARN i=" + i + " sun did not settle: sun_alt=" + R2(sun['altitude']))
  }

  moon = getOI("Moon")   // queried fresh AFTER sun settles, so it benefits too
  moon_alt = moon['altitude']
  moon_az = moon['azimuth']

  // frame: camera centered at (az=moon_az, alt=0) -- the horizon at the
  // moon's azimuth sits at the exact center of the frame, regardless of
  // the moon's actual altitude that night.
  core.moveToAltAzi(0, moon_az, 0); W(1)

  if (moon_alt < 0) { say("EDGE i=" + i + " moon not yet risen: moon_alt=" + R2(moon_alt)) }

  ssname = ((i + 100 + '').match(/.(..)/)[1]);
  cls()
  titles(TITHI + " #" + ssname + (moon_alt < 0 ? "  [below horizon]" : ""))
  titles([DT(), 'jd ' + R2(JD()), 'sun ' + R2(sun['altitude']) + 'd', 'moon ' + R2(moon_alt) + 'd @' + R2(moon_az) + 'd',
          R2(moon['illumination']) + '%', R2(moon['elong']) + 'd'].join("  ~  "))
  // Force a real wall-clock pause so at least one fresh frame paints before capture.
  core.wait(2)
  screenshot(TITHI, ssname)
  cls()
}

core.setTimeRate(1)  // restore normal clock

// sentinel: signals run completion to the caller polling the filesystem
screenshot(null, 'zzz-done')
say("a11 done")
