// Session 1 · Precession bridge demo
// Shows how equinoctial reference points and the pole-star situation shift across large epochs.
// Self-contained: no nakshatras.inc dependency.

function W(x)  { if (!x) x = 0.1; core.wait(x); }
function JD(x) { if (x) { core.setJDay(x); W(0.05); } return core.getJDay(); }
function DT()  { return core.getDate("local"); }

function resetScene() {
  LabelMgr.deleteAllLabels();
  MarkerMgr.deleteAllMarkers();
  CustomObjectMgr.removeCustomObjects();
}

function label(text, x, y, size, color) {
  var id = LabelMgr.labelScreen(text, x, y, false, size, color);
  LabelMgr.setLabelShow(id, true);
  return id;
}

var equinoxNaks = ["Uttara-proṣṭhapadā", "Revatī", "Aśvinī", "Bharaṇī", "Kṛttikā", "Rohiṇī"];
var poleStar = ["Polaris", "-", "-", "-", "-", "Thuban"];

resetScene();
core.setGuiVisible(false);
LandscapeMgr.setFlagLandscape(false);
LandscapeMgr.setFlagAtmosphere(false);
LandscapeMgr.setFlagFog(false);

// Intro title sequence
label("Precession of the Equinoxes", 70, 140, 34, "#22FFFF");
label("The equinoctial point and the pole-star situation shift together across long time spans.", 70, 210, 20, "#F8FAFC");
label("This is the bridge from visual sky change to textual dating.", 70, 250, 20, "#F8FAFC");
W(7);

resetScene();
label("Precession of the Equinoxes", 20, 24, 30, "#22FFFF");
label("NCP", 390, 400, 36, "#FF6B6B");
label("Equinox", 1000, 650, 30, "#FF00FF");
W(2);

for (var i = 0; i < 6; i++) {
  JD(2451623.54433 - i * 365242);
  label("Year " + DT().replace(/......T.*/, "") + ": equinox in " + equinoxNaks[i] + " | pole star " + poleStar[i], 960, 700 + i * 30, 20, "#F8FAFC");
  W(3);
}

label("Precession lets seasonal and equinoctial textual markers become dating clues.", 70, 1015, 20, "#FFD166");
label("Session 1 uses this for the Sun; Session 2 returns to it for the equinoctial full moon.", 70, 1050, 20, "#FFD166");
W(25);
