var $JD_0 = 1721057.284468;
function W(x)  { if (!x) x = 0.1; core.wait(x); }
function JD(x) { if (x) { core.setJDay(x); W(0.04); } return core.getJDay(); }
var getOI = core.getObjectInfo;

function resetScene() {
  LabelMgr.deleteAllLabels();
  MarkerMgr.deleteAllMarkers();
}

function label(text, x, y, size, color) {
  var id = LabelMgr.labelScreen(text, x, y, false, size, color);
  LabelMgr.setLabelShow(id, true);
  return id;
}

var epochRuns = [
  { year_name: "1800 BCE", year_num: 1800, arr: MERIDIANS_BCE_1800 },
  { year_name: "1350 BCE", year_num: 1350, arr: MERIDIANS_BCE_1350 },
  { year_name: "2000 CE",  year_num: -2000, arr: MERIDIANS_CE_2000 }
];

for (var e = 0; e < epochRuns.length; e++) {
  var run = epochRuns[e];
  var MERIDIANS = run.arr;
  var year = run.year_num;
  var year_label = run.year_name;
  
  for (var repeat_show = 0; repeat_show < 1; repeat_show++) {
    
    resetScene();
    core.setGuiVisible(false);
    core.setObserverLocation("Ujjain, India", "Earth");
    
    LandscapeMgr.setFlagLandscape(repeat_show == 0 ? true : false);
    LandscapeMgr.setFlagAtmosphere(repeat_show == 0 ? true : false);
    try {LandscapeMgr.setFlagGround(repeat_show == 0 ? false : true);} catch(err) {}
    LandscapeMgr.setFlagFog(false);
    LandscapeMgr.setFlagCardinalPoints(true);
    
    GridLinesMgr.setFlagAzimuthalGrid(true);
    GridLinesMgr.setFlagEquatorGrid(false);
    GridLinesMgr.setFlagEclipticLine(false);
    GridLinesMgr.setFlagEquatorLine(false);
    GridLinesMgr.setFlagMeridianLine(true);
    
    // Show constellation asterism lines
    ConstellationMgr.setFlagLines(!true);
    ConstellationMgr.setFlagLabels(!true);
    ConstellationMgr.setFlagBoundaries(true);
    
    // Face South (azimuth 180) to observe noon transits
    // Ujjain lat=23.2°. Sun alt ranges ~43° (winter) to ~90° (summer).
    // Set camera to alt=65°, az=180°. Zoom to 90° so we see from 20° up to 110°.
    var centerAlt = 88;
    var targetFov = 180;
    core.setProjectionMode("ProjectionFisheye");
    core.moveToAltAzi(centerAlt, 90+2*45, 0);
    StelMovementMgr.zoomTo(targetFov, 0);
    
    // Scale Sun appropriately and try to turn off glare
    try { SolarSystem.setFlagScaleSun(true); SolarSystem.setSunScale(15); } catch(err) {}
    try { StelSkyDrawer.setFlagSunGlare(false); } catch(err) {}
    try { SolarSystem.setFlagGlare(false); } catch(err) {}
    
    // Intro title sequence
    label("Translating the Meridian: High and Low Sun (" + year_label + ")", 70, 140, 36, "#FFAAAA");
    label("Ujjain: watch the noon Sun reach its highest and lowest peaks.", 70, 210, 30, "#FFFFFF");
    label("Demo setup: Changing the viewing altitude... starts in 15 seconds.", 70, 790, 25, "#FFFFFF");
    
    // Prime the sky to the exact meridian time on the first day
    JD(MERIDIANS[0]);
    W(15*2);
    
    resetScene();
    label("Meridian High/Low Shift Through the Year " + year_label, 70, 50, 30, "#FFD166");
    label("Ujjain: facing South at exact local noon (meridian transit)", 70, 95, 18, "#DDDDDD");
    W(1);
    
    var flagged = {};
    // Sweep through all exactly calculated noon JDs
    for (var d = 0; d < MERIDIANS.length; d++) {
      JD(MERIDIANS[d]); // Time step already gives us exact peak altitude!
      W(0.1);
      
      var sunInfo = getOI("Sun");
      var kind = null;
      var color = "#FFD166";
      
      // Look for elong = 90 (Summer solstice / Dakshinayana)
      if (!flagged.summer && Math.abs(sunInfo.elong - 90) < 1.0) { 
        kind = "Dakṣiṇāyana begins (High Noon Sun)"; 
        color = "#FF3333"; // Bright Red down-trend
        flagged.summer = true; 
      }
      else if (!flagged.autumn && Math.abs(sunInfo.elong - 180) < 1.0) { 
        kind = "Autumn Equinox (Mid Noon Sun)"; 
        color = "#FFD700"; // Bright Yellow/Gold
        flagged.autumn = true; 
      }
      else if (!flagged.winter && Math.abs(sunInfo.elong - 270) < 1.0) { 
        kind = "Uttarāyaṇa begins (Low Noon Sun)"; 
        color =  "#FF0000"; // Maroon 
        flagged.winter = true; 
      }
      else if (!flagged.spring && (sunInfo.elong < 1.0 || sunInfo.elong > 359.0)) { 
        kind = "Spring Equinox (Mid Noon Sun)"; 
        color = "#00FF00"; // Bright Lime Green
        flagged.spring = true; 
        flagged.dip = true;
      }
      
      if (kind) {
        var w = core.getScreenWidth();
        var h = core.getScreenHeight();
        
        // At targetFov=180, radial distance from camera center (Altitude=centerAlt, Azimuth=camAzi)
        var camAzi = 90 + 2*45; // 180
        var altDiff = (centerAlt - sunInfo.altitude);
        
        // Approximate radial distance in pixels (h/targetFov scales degrees to pixels)
        // A direct FOV=180 touches the top/bottom edges of the screen at 90 degrees out
        var r = altDiff * (h / targetFov) * 1.1; // 1.1 multiplier corrects for stereo stretching
        
        var angle = (sunInfo.azimuth - camAzi) * Math.PI / 180;
        var dx = r * Math.sin(angle);
        var dy = r * Math.cos(angle);
        
        // Offset 30px to right, 15px up from sun center
        var xPos = (w / 2) + dx + 30; 
        var yPos = (h / 2) + dy - 15;
        
        if (flagged.dip && kind.indexOf("Spring") !== -1) {
            yPos += 30; // slightly dip spring equinox so it doesn't cleanly overlap autumn
        }
        
        label(kind, xPos, yPos, 22, color);
      }
    }
    
    label("Together with the horizon-swing demo, this shows why Dakṣiṇāyana and Uttarāyaṇa are more than horizon labels.", 70, 1025, 20, "#FFFFFF");
    label("They mathematically define the Sun's shifting meridian height over the year.", 70, 1065, 20, "#AABBFF");
    W(10);
  }
}
W(25);
