core.setSkyCulture("vedic_25_codex")
var zoneAyanamsa = 23.5;
var zoneSector = 360 / 27;
var zoneFov = 35;
StelMovementMgr.zoomTo(220, 2); core.wait(1);
core.moveToRaDec(90, 120, 1);  core.wait(1);
var id = LabelMgr.labelScreen("A Tour of the 27 Nakṣatras", 220, 80, false, 30, "#F8FAFC");
LabelMgr.setLabelShow(id, true); core.wait(2);
var id2 = LabelMgr.labelScreen("Visible star-groups and sectors", 220, 120, false, 18, "#CBD5E1");
LabelMgr.setLabelShow(id2, true); core.wait(2);
var id3 = LabelMgr.labelScreen("Demo Note: Turn on the Skyculture/Nakshatra option in the GUI to see the ecliptic arc and the 27 sectors.", 120, 820, false,20, "#FF0000");
LabelMgr.setLabelShow(id3, true); core.wait(3);
LabelMgr.setLabelShow(id3, false); LabelMgr.deleteLabel(id3); core.wait(.3);
id3 = LabelMgr.labelScreen("Demo Note: Turn on the Skyculture/Nakshatra option in the GUI to see the ecliptic arc and the 27 sectors.", 120, 820, false,20, "#FF0000");
LabelMgr.setLabelShow(id3, true); core.wait(10);


LabelMgr.setLabelShow(id, false); LabelMgr.deleteLabel(id); core.wait(.3);
LabelMgr.setLabelShow(id2, false); LabelMgr.deleteLabel(id2); core.wait(.3);
LabelMgr.setLabelShow(id3, false); LabelMgr.deleteLabel(id3); core.wait(.3);

for (n in n28) {
  try {
    var naks = naks_info(n28[n]);
    var hobjs = naks.hips.map(
      function (h, i) {
        var oi;
        oi = core.getObjectInfo(h);
        core.wait(0.2);
        return oi;
      }
    )

    var zoneLon = zoneAyanamsa + (zoneSector * Number(n)) + zoneSector / 2;
    var coords = eclipticToEquatorial(zoneLon, 0);

    var cra = 0;
    var cdec = 0;
    for (h in hobjs) {
      cra += hobjs[h].ra;
      cdec += hobjs[h].dec;
    }
    cra = cra / hobjs.length;
    cdec = cdec / hobjs.length;
    core.moveToRaDec(cra, cdec, 1);

    var angles = hobjs.map(
      function (h, i) {
        return angleBetween(cra, cdec, h.ra, h.dec);
      }
    )
    var fov = 3 * angles.sort(function (a, b) {
      return b - a
    })[0];
    fov = fov < 2 ? 2 : fov;

    if (true) {
      core.selectObjectByName(naks.sanskrit_name, true);

      // Centers the view on the selected object over a duration of 2 seconds
      // core.moveToObject(naks.sanskrit_name, 2);
      var id = LabelMgr.labelScreen(naks.sanskrit_name, 500, 500, false, 30);
      LabelMgr.setLabelShow(id, true);
      core.wait(.3);
      var id1 = LabelMgr.labelScreen(naks.descr1, 500, 550, false, 15);
      LabelMgr.setLabelShow(id1, true);
      core.wait(.3);
      var idShape = LabelMgr.labelScreen("Shape:: " + naks.shape, 500, 580, false, 20, "#FFD700");
      LabelMgr.setLabelShow(idShape, true);
      core.wait(.3);

      StelMovementMgr.zoomTo(fov, 2.5);
      core.wait(1)
      ConstellationMgr.setConstellationLineThickness(4); core.wait(.3);
      core.wait(4);

      if (naks.sanskrit_name.indexOf("अभिजित") === -1) {
        var idZone = LabelMgr.labelScreen("Now shift from the visible group to the ecliptic sector.", 360, 640, false, 18, "#CBD5E1");
        LabelMgr.setLabelShow(idZone, true);
        core.wait(.8);
        core.moveToRaDec(coords.ra, coords.dec, 1.5);
        StelMovementMgr.zoomTo(zoneFov, 2.0);
        core.wait(2.5);
        LabelMgr.setLabelShow(idZone, false);
        LabelMgr.deleteLabel(idZone);
        core.wait(0.2);
      }

      StelMovementMgr.zoomTo(80, 1.5);
      core.wait(.5); 
      ConstellationMgr.setConstellationLineThickness(1); core.wait(0.1) 
      LabelMgr.setLabelShow(id, false);
      LabelMgr.deleteLabel(id);
      core.wait(0.1) 

      LabelMgr.setLabelShow(id1, false);
      LabelMgr.deleteLabel(id1);
      core.wait(0.1)

      LabelMgr.setLabelShow(idShape, false);
      LabelMgr.deleteLabel(idShape);
      core.wait(0.1)
    }


  } catch (e) {
    core.debug("skip " + n)
  }
}
